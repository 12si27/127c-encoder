<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="Encoder127c.MainWindow"
        x:CompileBindings="False"
        Title="127c-encoder"
        Icon="{OnPlatform Default='/Assets/app-icon.png', macOS='/Assets/app-icon-mac.png'}"
        Width="700"
        Height="600"
        MinWidth="600"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="파일">
        <NativeMenu>
          <NativeMenuItem Header="파일 열기…" Gesture="Meta+O" Click="OpenFilesFromMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="닫기" Gesture="Meta+W" Click="CloseFromMenu" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>
  <Window.Styles>
    <Style Selector="Button.settings-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#0078D4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.queue-header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="8,9" />
    </Style>
    <Style Selector="GridSplitter.queue-separator">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <Border Width="2" HorizontalAlignment="Center"
                    Background="{DynamicResource StatusBarBorderBrush}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </Window.Styles>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#454545" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#d1d1d1" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid RowDefinitions="*,Auto">
  <Grid x:Name="MainLayoutGrid" Grid.Row="0" Margin="24,24,24,0" RowDefinitions="*,Auto">
    <Grid Grid.Row="0" RowSpacing="14">
      <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="127c-encoder" FontSize="28" FontWeight="Bold" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="AddFilesButton" ToolTip.Tip="비디오 파일 추가" Click="PickInputFiles">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:FluentIcon Icon="DocumentAdd" IconVariant="Regular" IconSize="Size20" />
            <TextBlock Text="추가" />
          </StackPanel>
        </Button>
        <Button x:Name="RemoveSelectedButton" ToolTip.Tip="선택한 파일 제거" Click="RemoveSelectedFile">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:FluentIcon Icon="DeleteDismiss" IconVariant="Regular" IconSize="Size20" />
            <TextBlock Text="제거" />
          </StackPanel>
        </Button>
        <Button x:Name="ClearFilesButton" ToolTip.Tip="목록 전체 비우기" Click="ClearFiles">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:FluentIcon Icon="DismissCircle" IconVariant="Regular" IconSize="Size20" />
            <TextBlock Text="비우기" />
          </StackPanel>
        </Button>
        <Button x:Name="QueueMenuButton" ToolTip.Tip="더 보기" AutomationProperties.Name="더 보기">
          <ic:FluentIcon Icon="MoreHorizontal" IconVariant="Regular" IconSize="Size20" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="QueueMenuOpening">
              <MenuItem x:Name="SelectAllQueueMenuItem" Header="모두 선택" Click="SelectAllQueueItems" />
              <MenuItem x:Name="InvertQueueSelectionMenuItem" Header="선택 반전" Click="InvertQueueSelection" />
              <Separator />
              <MenuItem x:Name="ResetSelectedSettingsMenuItem" Header="설정 초기화" IsVisible="False"
                        Click="ResetSelectedQueueSettings" />
              <MenuItem x:Name="ResetSelectedStatusMenuItem" Header="상태 초기화" IsEnabled="False"
                        Click="ResetSelectedQueueStatus" />
              <Separator />
              <MenuItem Header="프로그램 위치 열기" Click="OpenProgramDirectory" />
              <MenuItem x:Name="PreventSleepMenuItem" Header="인코딩 중 절전 방지"
                        ToggleType="CheckBox" IsChecked="True" Click="PreventSleepChanged" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <Border x:Name="QueueDropBorder"
            Grid.Row="1" Grid.RowSpan="2"
            MinHeight="180"
            Background="Transparent"
            BorderBrush="#26000000"
            BorderThickness="1"
            CornerRadius="6">
      <Grid RowDefinitions="Auto,*">
        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource StatusBarBorderBrush}" BorderThickness="0,0,0,1">
          <Grid x:Name="QueueHeader" Margin="12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" MinWidth="120" />
              <ColumnDefinition Width="120" MinWidth="80" />
              <ColumnDefinition Width="100" MinWidth="80" />
            </Grid.ColumnDefinitions>
            <Button x:Name="FileQueueHeader" Grid.Column="1" Classes="queue-header"
                    Content="파일" Tag="FileName" Click="SortQueue" ToolTip.Tip="파일명으로 정렬" />
            <Button x:Name="SizeQueueHeader" Grid.Column="2" Classes="queue-header"
                    Content="용량" Tag="FileSize" Click="SortQueue" ToolTip.Tip="용량으로 정렬" />
            <Button x:Name="StatusQueueHeader" Grid.Column="3" Classes="queue-header"
                    Content="상태" Tag="Status" Click="SortQueue" ToolTip.Tip="상태로 정렬" />
            <GridSplitter Grid.Column="1" Classes="queue-separator" Width="6" HorizontalAlignment="Right"
                          Background="Transparent" Margin="0,8"
                          ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" />
            <GridSplitter Grid.Column="2" Classes="queue-separator" Width="6" HorizontalAlignment="Right"
                          Background="Transparent" Margin="0,8"
                          ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" />
          </Grid>
        </Border>
        <ListBox x:Name="QueueListBox" Grid.Row="1"
                 ItemsSource="{Binding EncodingQueue}"
                 SelectionMode="Multiple"
                 Focusable="True"
                 SelectionChanged="QueueSelectionChanged"
                 Padding="0"
                 BorderThickness="0">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border x:Name="QueueItemBorder" Background="{Binding Background}" Padding="12,9">
                <Border.ContextMenu>
                  <ContextMenu DataContext="{Binding #QueueItemBorder.DataContext}"
                               Opening="QueueItemContextMenuOpening">
                    <MenuItem Header="원본 위치 열기" Click="OpenQueueItemSourceFolder" />
                    <MenuItem Header="출력 위치 열기" Click="OpenQueueItemOutputFolder" />
                    <MenuItem Header="비디오별 설정…" Click="OpenQueueItemSettings" />
                    <MenuItem Header="게인 분석…" Click="AnalyzeQueueItemGain" />
                    <MenuItem Header="설정 초기화" IsVisible="False" Click="ResetQueueItemSettings" />
                    <MenuItem Header="상태 초기화" Click="ResetQueueItemStatus" />
                    <MenuItem Header="목록에서 제거" Click="RemoveQueueItem" />
                    <Separator />
                    <MenuItem Header="모두 선택" InputGesture="Ctrl+A" Click="SelectAllQueueItems" />
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid x:Name="QueueRowGrid" ColumnDefinitions="36,*,120,100" Loaded="QueueRowLoaded">
                  <Border x:Name="QueueDragHandle" Background="Transparent" Cursor="SizeAll"
                          ToolTip.Tip="드래그하여 순서 변경" Margin="-12,-9,4,-9" Padding="12,9,8,9">
                    <Path Data="M 0,3 H 14 M 0,8 H 14 M 0,13 H 14"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                          StrokeThickness="1.5" Width="14" Height="16" Opacity="0.55"
                          VerticalAlignment="Center" />
                  </Border>
                  <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="8,0">
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text=" *" IsVisible="{Binding HasCustomSettings}"
                               VerticalAlignment="Center" ToolTip.Tip="비디오별 설정 적용됨" />
                  </Grid>
                  <TextBlock Grid.Column="2" Text="{Binding FileSizeText}" Margin="8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding StatusText}" Margin="8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Canvas Grid.Row="1" x:Name="QueueInsertionOverlay" IsHitTestVisible="False" ClipToBounds="True">
          <Border x:Name="QueueInsertionLine" Height="2" Background="#0078D4"
                  CornerRadius="1" IsVisible="False" />
        </Canvas>
        <StackPanel Grid.Row="1" x:Name="DropHintPanel"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
          <Viewbox Width="48" Height="48" HorizontalAlignment="Center" Opacity="0.55">
            <ic:FluentIcon Icon="VideoAdd" IconVariant="Regular" IconSize="Size20" />
          </Viewbox>
          <TextBlock x:Name="DropHintTextBlock"
                     Text="이곳에 드래그 앤 드롭하거나 ‘추가’를 누르세요"
                     HorizontalAlignment="Center"
                     Opacity="0.55" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
      <TextBox x:Name="OutputDirectoryTextBox" Grid.Column="1" PlaceholderText="출력 폴더" />
      <CheckBox x:Name="UseSourceDirectoryCheckBox"
                Grid.Column="2"
                Content="원본 위치"
                VerticalAlignment="Center"
                Margin="10,0,0,0"
                IsCheckedChanged="UseSourceDirectoryChanged" />
      <Button x:Name="PickOutputFolderButton" Grid.Column="3" Margin="10,0,0,0" ToolTip.Tip="출력 폴더 선택" Click="PickOutputFolder">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="FolderAdd" IconVariant="Regular" IconSize="Size20" />
          <TextBlock Text="선택" />
        </StackPanel>
      </Button>
      <Button x:Name="OpenOutputFolderButton" Grid.Column="4" Margin="8,0,0,0" ToolTip.Tip="출력 폴더 열기" Click="OpenOutputFolder">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="FolderOpen" IconVariant="Regular" IconSize="Size20" />
          <TextBlock Text="열기" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="4" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
        <StackPanel x:Name="EncodingProfilePanel" Grid.Row="0" Spacing="2" HorizontalAlignment="Left">
          <TextBlock Text="인코딩 프로필" FontSize="12" Opacity="0.7" Margin="2,0,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ComboBox x:Name="EncodingProfileComboBox" MinWidth="110" SelectionChanged="EncodingProfileChanged">
              <ComboBoxItem Content="기본" Tag="default" />
              <ComboBoxItem Content="절약" Tag="saving" />
              <ComboBoxItem Content="오디오만" Tag="audio-only" />
            </ComboBox>
            <Button x:Name="ToggleDetailedSettingsButton"
                    Classes="settings-link" VerticalAlignment="Center"
                    Click="ToggleDetailedSettings">
              <TextBlock x:Name="ToggleDetailedSettingsText" Text="▼ 세부 설정" />
            </Button>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="DetailedSettingsPanel" Grid.Row="1" Grid.ColumnSpan="2" Spacing="4"
                    Margin="0,8,0,0" IsVisible="False">
    <WrapPanel ItemSpacing="16" LineSpacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="프리셋" FontSize="12" Opacity="0.7" Margin="2,0,0,0" />
          <ComboBox x:Name="VideoPresetComboBox" SelectedIndex="2">
            <ComboBoxItem Content="빠르게 (fast)" Tag="fast" />
            <ComboBoxItem Content="균형 (medium)" Tag="medium" />
            <ComboBoxItem Content="고품질 (slow)" Tag="slow" />
          </ComboBox>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="디인터레이싱" FontSize="12" Opacity="0.7" Margin="2,0,0,0" />
          <ComboBox x:Name="DeinterlaceModeComboBox" SelectedIndex="0">
            <ComboBoxItem Content="자동" Tag="auto" />
            <ComboBoxItem Content="항상 적용" Tag="always" />
            <ComboBoxItem Content="사용 안 함" Tag="off" />
          </ComboBox>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="MBR / 버퍼 (k)" FontSize="12" Opacity="0.7" Margin="2,0,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <NumericUpDown x:Name="VideoMaxBitrateNumericUpDown"
                           Value="2000"
                           Minimum="1"
                           Maximum="1000000"
                           Increment="100"
                           ShowButtonSpinner="False"
                           FormatString="0" />
            <NumericUpDown x:Name="VideoBufferSizeNumericUpDown"
                           Value="4000"
                           Minimum="1"
                           Maximum="1000000"
                           Increment="100"
                           ShowButtonSpinner="False"
                           FormatString="0" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="게인 (dB)" FontSize="12" Opacity="0.7" Margin="2,0,0,0" />
          <NumericUpDown x:Name="AudioGainNumericUpDown"
                           Value="0"
                           Minimum="-60"
                           Maximum="60"
                           Increment="1"
                           FormatString="0" />
        </StackPanel>
        <StackPanel Spacing="2">
          <CheckBox x:Name="DynamicAudioNormalizationCheckBox" Content="노멀라이징" Margin="0,19,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </WrapPanel>
      <Button x:Name="ResetSettingsButton"
              Classes="settings-link"
              HorizontalAlignment="Left"
              ToolTip.Tip="출력 폴더와 인코딩 옵션을 기본값으로 되돌립니다"
              Click="ResetSettings">
        <TextBlock Text="기본값으로 설정" TextDecorations="Underline" />
      </Button>
        </StackPanel>

    <Grid x:Name="EncodingActionsGrid" Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto"
          ColumnSpacing="10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <Button x:Name="ToggleLogButton" Grid.Column="0" Click="ShowLogWindow">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="DocumentText" IconVariant="Regular" IconSize="Size20" />
          <TextBlock x:Name="ToggleLogButtonText" Text="로그 보기" />
        </StackPanel>
      </Button>
      <Button x:Name="DownloadEncodersButton" Grid.Column="1" Padding="18,10" IsVisible="False" Click="DownloadEncoders">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="DocumentArrowDown" IconVariant="Regular" IconSize="Size20" />
          <TextBlock Text="인코더 다운로드" />
        </StackPanel>
      </Button>
      <Button x:Name="EncodeButton" Grid.Column="2" MinWidth="100" Padding="18,10" IsEnabled="False" Click="StartEncoding">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon x:Name="EncodeButtonIcon" Icon="PlayCircle" IconVariant="Regular" IconSize="Size20" />
          <TextBlock x:Name="EncodeButtonText" Text="인코딩 시작" />
        </StackPanel>
      </Button>
    </Grid>
    </Grid>

    </Grid>

    <StackPanel x:Name="AuxiliaryPanel"
                Grid.Row="1"
                IsVisible="False">
    <Grid RowDefinitions="Auto,Auto">
      <TextBlock x:Name="EncodingProgressTextBlock" IsVisible="False" Opacity="0.75" />
      <ProgressBar x:Name="EncodingProgressBar" Grid.Row="1" Height="6" Margin="0,0,0,24" IsVisible="False" IsIndeterminate="True"/>
    </Grid>

    </StackPanel>
  </Grid>
    <Border Grid.Row="1"
              Height="24"
              Padding="6,0"
              BorderBrush="{DynamicResource StatusBarBorderBrush}"
              BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusTextBlock"
                 Text="인코더 준비 상태를 확인하는 중..."
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 FontSize="14"
                 Opacity="0.8" />
    </Border>
  </Grid>
</Window>

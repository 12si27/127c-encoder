<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Encoder127c.MainWindow"
        Title="127c-encoder"
        Width="820"
        Height="680"
        MinWidth="700"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="127c-encoder"
                 FontSize="28"
                 FontWeight="Bold" />
      <!-- <TextBlock Text="ffmpeg를 이용한 비디오 인코딩 도구"
                 Opacity="0.7" /> -->
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,24,0,0" ColumnDefinitions="140,*,Auto">
      <TextBlock Grid.Column="0"
                 Text="입력 비디오"
                 VerticalAlignment="Center" />
      <TextBox x:Name="InputPathTextBox"
               Grid.Column="1"
               PlaceholderText="비디오 파일을 선택하세요"
               IsReadOnly="True" />
      <Button Grid.Column="2"
              Margin="10,0,0,0"
              Content="찾아보기..."
              Click="PickInputFile" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="140,*,Auto">
      <TextBlock Grid.Column="0"
                 Text="출력 폴더"
                 VerticalAlignment="Center" />
      <TextBox x:Name="OutputDirectoryTextBox"
               Grid.Column="1"
               PlaceholderText="출력 폴더" />
      <Button Grid.Column="2"
              Margin="10,0,0,0"
              Content="폴더 선택..."
              Click="PickOutputFolder" />
    </Grid>

    <Border Grid.Row="3"
            Margin="0,24,0,0"
            Padding="16"
            BorderBrush="#33000000"
            BorderThickness="1"
            CornerRadius="6">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   Text="인코딩 프리셋"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="1" Grid.Column="0" Margin="0,14,12,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="100,*">
          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" Text="프리셋" VerticalAlignment="Center" />
          <ComboBox x:Name="VideoPresetComboBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" SelectedIndex="2">
            <ComboBoxItem Content="빠르게 (fast)" Tag="fast" />
            <ComboBoxItem Content="균형 (medium)" Tag="medium" />
            <ComboBoxItem Content="고품질 (slow)" Tag="slow" />
          </ComboBox>
          <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" Text="최대 비트레이트" VerticalAlignment="Center" />
          <TextBox x:Name="VideoMaxBitrateTextBox" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Text="2000k" />
          <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,10,0,0" Text="버퍼 크기" VerticalAlignment="Center" />
          <TextBox x:Name="VideoBufferSizeTextBox" Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Text="4000k" />
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Margin="12,14,0,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="100,*">
          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" Text="게인" VerticalAlignment="Center" />
          <Grid Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
            <TextBox x:Name="AudioGainTextBox" Grid.Column="0" Text="0" />
            <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="dB" VerticalAlignment="Center" />
          </Grid>
          <CheckBox x:Name="DynamicAudioNormalizationCheckBox"
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,10,0,0"
                    Content="다이내믹 노멀라이징" />
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="0,20,0,0" ColumnDefinitions="*,Auto,Auto">
      <TextBlock x:Name="StatusTextBlock"
                 Grid.Column="0"
                 Text="FFmpeg 설치 상태를 확인하는 중..."
                 VerticalAlignment="Center"
                 TextWrapping="Wrap" />
      <Button x:Name="DownloadFfmpegButton"
              Grid.Column="1"
              Margin="10,0,0,0"
              Padding="18,10"
              Content="FFmpeg 다운로드"
              IsVisible="False"
              Click="DownloadFfmpeg" />
      <Button x:Name="EncodeButton"
              Grid.Column="2"
              MinWidth="90"
              Padding="18,10"
              Content="▶ 인코딩 시작"
              IsEnabled="False"
              Click="StartEncoding" />
    </Grid>

    <ProgressBar x:Name="EncodingProgressBar"
                 Grid.Row="5"
                 Margin="0,12,0,0"
                 Height="6"
                 IsVisible="False"
                 IsIndeterminate="True" />

    <TextBlock x:Name="EncodingProgressTextBlock"
               Grid.Row="6"
               Margin="0,6,0,0"
               IsVisible="False"
               Opacity="0.75" />

    <TextBlock Grid.Row="7"
               Margin="0,20,0,8"
               Text="ffmpeg 로그"
               FontWeight="SemiBold" />
    <TextBox x:Name="LogTextBox"
             Grid.Row="8"
             MinHeight="100"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
  </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Encoder127c.MainWindow"
        x:CompileBindings="False"
        Title="127c-encoder"
        Width="860"
        Height="720"
        MinWidth="700"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,*" RowSpacing="14">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="127c-encoder" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="파일을 추가한 순서대로 인코딩합니다." Opacity="0.65" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="AddFilesButton" Content="파일 추가" Click="PickInputFiles" />
        <Button x:Name="RemoveSelectedButton" Content="선택 제거" Click="RemoveSelectedFile" />
        <Button x:Name="ClearFilesButton" Content="모두 제거" Click="ClearFiles" />
        <Button x:Name="MoveUpButton" Content="↑" ToolTip.Tip="위로 이동" Click="MoveSelectedUp" />
        <Button x:Name="MoveDownButton" Content="↓" ToolTip.Tip="아래로 이동" Click="MoveSelectedDown" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,120,100" Margin="12,0,12,0">
      <TextBlock Text="파일" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" Text="용량" FontWeight="SemiBold" />
      <TextBlock Grid.Column="2" Text="상태" FontWeight="SemiBold" />
    </Grid>

    <Border x:Name="QueueDropBorder"
            Grid.Row="2"
            MinHeight="180"
            BorderBrush="#26000000"
            BorderThickness="1"
            CornerRadius="6">
      <Grid>
        <ListBox x:Name="QueueListBox"
                 ItemsSource="{Binding EncodingQueue}"
                 SelectionChanged="QueueSelectionChanged"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="{Binding Background}" Padding="12,9">
                <Grid ColumnDefinitions="*,120,100">
                  <TextBlock Text="{Binding FileName}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding FileSizeText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="DropHintTextBlock"
                   Text="비디오 파일을 이곳에 드래그 앤 드롭하거나 ‘파일 추가’를 누르세요"
                   IsHitTestVisible="False"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.55" />
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="90,*,Auto">
      <TextBlock Text="출력 폴더" VerticalAlignment="Center" />
      <TextBox x:Name="OutputDirectoryTextBox" Grid.Column="1" PlaceholderText="출력 폴더" />
      <Button x:Name="PickOutputFolderButton" Grid.Column="2" Margin="10,0,0,0" Content="폴더 선택" Click="PickOutputFolder" />
    </Grid>

    <Grid Grid.Row="4" ColumnDefinitions="Auto,130,Auto,110,Auto,110,Auto,100,Auto" ColumnSpacing="8">
      <TextBlock Text="프리셋" VerticalAlignment="Center" />
      <ComboBox x:Name="VideoPresetComboBox" Grid.Column="1" SelectedIndex="2">
        <ComboBoxItem Content="빠르게" Tag="fast" />
        <ComboBoxItem Content="균형" Tag="medium" />
        <ComboBoxItem Content="고품질" Tag="slow" />
      </ComboBox>
      <TextBlock Grid.Column="2" Text="최대 비트레이트" VerticalAlignment="Center" />
      <TextBox x:Name="VideoMaxBitrateTextBox" Grid.Column="3" Text="2000k" />
      <TextBlock Grid.Column="4" Text="버퍼" VerticalAlignment="Center" />
      <TextBox x:Name="VideoBufferSizeTextBox" Grid.Column="5" Text="4000k" />
      <TextBlock Grid.Column="6" Text="게인" VerticalAlignment="Center" />
      <TextBox x:Name="AudioGainTextBox" Grid.Column="7" Text="0" />
      <CheckBox x:Name="DynamicAudioNormalizationCheckBox" Grid.Column="8" Content="노멀라이징" VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <TextBlock x:Name="StatusTextBlock" Grid.Column="0" Text="FFmpeg 설치 상태를 확인하는 중..." VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button x:Name="DownloadFfmpegButton" Grid.Column="1" Padding="18,10" Content="FFmpeg 다운로드" IsVisible="False" Click="DownloadFfmpeg" />
      <Button x:Name="EncodeButton" Grid.Column="2" MinWidth="110" Padding="18,10" Content="인코딩 시작" IsEnabled="False" Click="StartEncoding" />
    </Grid>

    <ProgressBar x:Name="EncodingProgressBar" Grid.Row="6" Height="6" IsVisible="False" IsIndeterminate="True" />

    <Grid Grid.Row="7" RowDefinitions="Auto,*" RowSpacing="6">
      <TextBlock x:Name="EncodingProgressTextBlock" IsVisible="False" Opacity="0.75" />
      <TextBox x:Name="LogTextBox" Grid.Row="1" MinHeight="90" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
    </Grid>
  </Grid>
</Window>

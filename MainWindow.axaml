<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="Encoder127c.MainWindow"
        x:CompileBindings="False"
        Title="127c-encoder"
        Icon="/Assets/app-icon.png"
        Width="800"
        Height="700"
        MinWidth="500"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="파일">
        <NativeMenu>
          <NativeMenuItem Header="파일 열기…" Gesture="Meta+O" Click="OpenFilesFromMenu" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="닫기" Gesture="Meta+W" Click="CloseFromMenu" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>
  <Window.Styles>
    <Style Selector="Button.settings-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#0078D4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Styles>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#454545" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#d1d1d1" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid RowDefinitions="*,Auto">
  <Grid x:Name="MainLayoutGrid" Grid.Row="0" Margin="24,24,24,0" RowDefinitions="*,Auto">
    <Grid Grid.Row="0" RowSpacing="14">
      <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="127c-encoder" FontSize="28" FontWeight="Bold" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="AddFilesButton" ToolTip.Tip="비디오 파일 추가" Click="PickInputFiles">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:FluentIcon Icon="DocumentAdd" IconVariant="Regular" IconSize="Size20" />
            <TextBlock Text="파일 추가" />
          </StackPanel>
        </Button>
        <Button x:Name="RemoveSelectedButton" ToolTip.Tip="선택한 파일 제거" Click="RemoveSelectedFile">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:FluentIcon Icon="DeleteDismiss" IconVariant="Regular" IconSize="Size20" />
            <TextBlock Text="선택 제거" />
          </StackPanel>
        </Button>
        <Button x:Name="ClearFilesButton" ToolTip.Tip="목록 전체 비우기" Click="ClearFiles">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:FluentIcon Icon="DismissCircle" IconVariant="Regular" IconSize="Size20" />
            <TextBlock Text="모두 제거" />
          </StackPanel>
        </Button>
        <Button x:Name="MoveUpButton" ToolTip.Tip="위로 이동" Click="MoveSelectedUp">
          <ic:FluentIcon Icon="ArrowUp" IconVariant="Regular" IconSize="Size20" />
        </Button>
        <Button x:Name="MoveDownButton" ToolTip.Tip="아래로 이동" Click="MoveSelectedDown">
          <ic:FluentIcon Icon="ArrowDown" IconVariant="Regular" IconSize="Size20" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,120,100" Margin="12,0,12,0">
      <TextBlock Text="파일" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" Text="용량" FontWeight="SemiBold" />
      <TextBlock Grid.Column="2" Text="상태" FontWeight="SemiBold" />
    </Grid>

    <Border x:Name="QueueDropBorder"
            Grid.Row="2"
            MinHeight="180"
            BorderBrush="#26000000"
            BorderThickness="1"
            CornerRadius="6">
      <Grid>
        <ListBox x:Name="QueueListBox"
                 ItemsSource="{Binding EncodingQueue}"
                 SelectionChanged="QueueSelectionChanged"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="{Binding Background}" Padding="12,9">
                <Grid ColumnDefinitions="*,120,100">
                  <TextBlock Text="{Binding FileName}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding FileSizeText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="DropHintTextBlock"
                   Text="비디오 파일을 이곳에 드래그 앤 드롭하거나 ‘파일 추가’를 누르세요"
                   IsHitTestVisible="False"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.55" />
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
      <TextBlock Text="출력 폴더" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBox x:Name="OutputDirectoryTextBox" Grid.Column="1" PlaceholderText="출력 폴더" />
      <CheckBox x:Name="UseSourceDirectoryCheckBox"
                Grid.Column="2"
                Content="원본 위치"
                VerticalAlignment="Center"
                Margin="10,0,0,0"
                IsCheckedChanged="UseSourceDirectoryChanged" />
      <Button x:Name="PickOutputFolderButton" Grid.Column="3" Margin="10,0,0,0" ToolTip.Tip="출력 폴더 선택" Click="PickOutputFolder">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="FolderAdd" IconVariant="Regular" IconSize="Size20" />
          <TextBlock Text="폴더 선택" />
        </StackPanel>
      </Button>
      <Button x:Name="OpenOutputFolderButton" Grid.Column="4" Margin="8,0,0,0" ToolTip.Tip="출력 폴더 열기" Click="OpenOutputFolder">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="FolderOpen" IconVariant="Regular" IconSize="Size20" />
          <TextBlock Text="폴더 열기" />
        </StackPanel>
      </Button>
    </Grid>

    <StackPanel x:Name="EncodingSettingsPanel" Grid.Row="4" Spacing="4">
    <WrapPanel ItemSpacing="16" LineSpacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="인코딩 프로필" FontSize="12" Opacity="0.7" Margin="2,0,0,0" />
          <ComboBox x:Name="EncodingProfileComboBox" SelectionChanged="EncodingProfileChanged">
            <ComboBoxItem Content="기본" Tag="default" />
            <ComboBoxItem Content="절약" Tag="saving" />
          </ComboBox>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="프리셋" FontSize="12" Opacity="0.7" Margin="2,0,0,0" />
          <ComboBox x:Name="VideoPresetComboBox" SelectedIndex="2">
            <ComboBoxItem Content="빠르게 (fast)" Tag="fast" />
            <ComboBoxItem Content="균형 (medium)" Tag="medium" />
            <ComboBoxItem Content="고품질 (slow)" Tag="slow" />
          </ComboBox>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="디인터레이싱" FontSize="12" Opacity="0.7" Margin="2,0,0,0" />
          <ComboBox x:Name="DeinterlaceModeComboBox" SelectedIndex="0">
            <ComboBoxItem Content="자동" Tag="auto" />
            <ComboBoxItem Content="항상 적용" Tag="always" />
            <ComboBoxItem Content="사용 안 함" Tag="off" />
          </ComboBox>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="MBR / 버퍼 (k)" FontSize="12" Opacity="0.7" Margin="2,0,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <NumericUpDown x:Name="VideoMaxBitrateNumericUpDown"
                           Value="2000"
                           Minimum="1"
                           Maximum="1000000"
                           Increment="100"
                           ShowButtonSpinner="False"
                           FormatString="0" />
            <NumericUpDown x:Name="VideoBufferSizeNumericUpDown"
                           Value="4000"
                           Minimum="1"
                           Maximum="1000000"
                           Increment="100"
                           ShowButtonSpinner="False"
                           FormatString="0" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="게인 (dB)" FontSize="12" Opacity="0.7" Margin="2,0,0,0" />
          <NumericUpDown x:Name="AudioGainNumericUpDown"
                           Value="0"
                           Minimum="-60"
                           Maximum="60"
                           Increment="1"
                           FormatString="0" />
        </StackPanel>
        <StackPanel Spacing="2">
          <CheckBox x:Name="DynamicAudioNormalizationCheckBox" Content="노멀라이징" Margin="0,19,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </WrapPanel>
      <Button x:Name="ResetSettingsButton"
              Classes="settings-link"
              HorizontalAlignment="Left"
              ToolTip.Tip="출력 폴더와 인코딩 옵션을 기본값으로 되돌립니다"
              Click="ResetSettings">
        <TextBlock Text="기본값으로 설정" TextDecorations="Underline" />
      </Button>
    </StackPanel>

    <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,24">
      <Button x:Name="ToggleLogButton" Grid.Column="1" Click="ToggleLogVisibility">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="DocumentText" IconVariant="Regular" IconSize="Size20" />
          <TextBlock x:Name="ToggleLogButtonText" Text="로그 표시" />
        </StackPanel>
      </Button>
      <Button x:Name="DownloadEncodersButton" Grid.Column="2" Padding="18,10" IsVisible="False" Click="DownloadEncoders">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon Icon="DocumentArrowDown" IconVariant="Regular" IconSize="Size20" />
          <TextBlock Text="FFmpeg 다운로드" />
        </StackPanel>
      </Button>
      <Button x:Name="EncodeButton" Grid.Column="3" MinWidth="100" Padding="18,10" IsEnabled="False" Click="StartEncoding">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ic:FluentIcon x:Name="EncodeButtonIcon" Icon="PlayCircle" IconVariant="Regular" IconSize="Size20" />
          <TextBlock x:Name="EncodeButtonText" Text="인코딩 시작" />
        </StackPanel>
      </Button>
    </Grid>

    </Grid>

    <StackPanel x:Name="AuxiliaryPanel"
                Grid.Row="1"
                IsVisible="False">
    <Grid RowDefinitions="Auto,Auto">
      <TextBlock x:Name="EncodingProgressTextBlock" IsVisible="False" Opacity="0.75" />
      <ProgressBar x:Name="EncodingProgressBar" Grid.Row="1" Height="6" Margin="0,0,0,24" IsVisible="False" IsIndeterminate="True"/>
    </Grid>

    <Border x:Name="LogPanel" IsVisible="False" Padding="0,0,0,24">
      <TextBox x:Name="LogTextBox"
               Height="140"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
    </Border>
    </StackPanel>
  </Grid>
    <Border Grid.Row="1"
              Height="24"
              Padding="6,0"
              BorderBrush="{DynamicResource StatusBarBorderBrush}"
              BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusTextBlock"
                 Text="인코더 준비 상태를 확인하는 중..."
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 FontSize="14"
                 Opacity="0.8" />
    </Border>
  </Grid>
</Window>
